# Copie para .env.local e preencha. Nunca faça commit do .env.local.
# Local: os valores aparecem ao rodar `npx supabase start`.
# Staging: Supabase → Project Settings → API Keys.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Chave publishable (sb_publishable_...): pode ir para o navegador; a RLS protege os dados.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secret (sb_secret_...): ignora a RLS. SÓ no servidor, em src/server/admin.
# Sem o prefixo NEXT_PUBLIC_ de propósito: assim o Next.js nunca a envia ao navegador.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
